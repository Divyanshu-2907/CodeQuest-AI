---
const features = [
  {
    title: "Story-Driven Missions",
    desc: "5 chapters and 20+ missions set in a dystopian future where AI rules. Hack mainframes, build autonomous agents, and overthrow the system.",
    icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
  },
  {
    title: "Real Code Execution",
    desc: "No multiple choice questions. Write real Python code in our secure, sandboxed Jupyter-style environment with live output and error tracking.",
    icon: "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
  },
  {
    title: "AI Judge + Hints",
    desc: "Our custom Claude-powered AI judge doesn't just pass/fail you. It explains why your model is underfitting or how your RAG pipeline can be optimized.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z"
  },
  {
    title: "XP + Leaderboard",
    desc: "Earn XP for efficient code and optimal model metrics. Compete globally on the developer leaderboard and earn exclusive profile badges.",
    icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
  },
  {
    title: "NPC Fixer System",
    desc: "Interact with 5 unique NPC characters who act as your clients, mentors, and sometimes adversaries. They provide context and requirements for every mission.",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
  },
  {
    title: "Boss Challenges",
    desc: "End each chapter with a timed benchmark battle. Deploy your model against a hidden test set. If your F1 score isn't high enough, you fail the mission.",
    icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
  }
];
---
<section id="features" class="py-24 px-6 border-t border-[var(--border)] relative bg-[var(--bg-base)]">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16 flex flex-col">
      <div class="page-tag">
        // SYSTEM_CAPABILITIES
      </div>
      <h2 class="page-heading text-3xl md:text-5xl max-w-2xl">Everything You Need to Master AI/ML</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map(feature => (
        <div class="lift p-6 rounded-lg relative" style="background: var(--bg-surface-2); border: 1px solid var(--border);">
          <div class="w-10 h-10 mb-5 flex items-center justify-center rounded" style="background: rgba(127,119,221,0.1); border: 1px solid rgba(127,119,221,0.2);">
            <svg class="w-5 h-5 text-[var(--purple-bright)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon}></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2">{feature.title}</h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

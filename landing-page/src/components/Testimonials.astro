---
---
<section id="testimonials" class="py-24 px-6 border-t border-[var(--border)] relative bg-[var(--bg-base)]">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="page-tag justify-center">
        // FEEDBACK_LOGS
      </div>
      <h2 class="page-heading text-3xl md:text-5xl">What Developers Are Saying</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Testimonial 1 -->
      <div class="lift p-8 rounded-lg relative" style="background: var(--bg-surface-2); border: 1px solid var(--border);">
        <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org/",
          "@type": "Review",
          "itemReviewed": {
            "@type": "SoftwareApplication",
            "name": "CodeQuest AI"
          },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5"
          },
          "author": {
            "@type": "Person",
            "name": "Marcus T."
          },
          "reviewBody": "Finally, an AI course that isn't just watching a 10-hour video. Building actual RAG pipelines to progress the story made everything click for me. I use these concepts at my job now."
        }
        </script>
        <div class="font-mono text-[10px] tracking-widest text-[var(--text-muted)] mb-4 uppercase">
          Rating: ★★★★★
        </div>
        <p class="text-sm leading-relaxed text-[var(--text-secondary)] italic mb-8 border-l-2 pl-4" style="border-color: var(--border-bright);">
          "Finally, an AI course that isn't just watching a 10-hour video. Building actual RAG pipelines to progress the story made everything click for me. I use these concepts at my job now."
        </p>
        <div class="flex items-center gap-3 mt-auto">
          <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs"
               style="background: rgba(127,119,221,0.1); color: var(--purple-dim); border: 1px solid rgba(127,119,221,0.3);">
            MT
          </div>
          <div>
            <div class="text-[13px] font-bold text-[var(--text-primary)]">Marcus T.</div>
            <div class="font-mono text-[10px] text-[var(--text-muted)]">Backend Engineer</div>
          </div>
        </div>
      </div>

      <!-- Testimonial 2 -->
      <div class="lift p-8 rounded-lg relative" style="background: var(--bg-surface-2); border: 1px solid var(--border);">
        <script type="application/ld+json">
        {
          "@context": "https://schema.org/",
          "@type": "Review",
          "itemReviewed": {
            "@type": "SoftwareApplication",
            "name": "CodeQuest AI"
          },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5"
          },
          "author": {
            "@type": "Person",
            "name": "Sarah J."
          },
          "reviewBody": "The AI Judge is incredible. It didn't just tell me my F1 score was too low; it analyzed my code and suggested I was overfitting due to lack of regularization. Best learning experience ever."
        }
        </script>
        <div class="font-mono text-[10px] tracking-widest text-[var(--text-muted)] mb-4 uppercase">
          Rating: ★★★★★
        </div>
        <p class="text-sm leading-relaxed text-[var(--text-secondary)] italic mb-8 border-l-2 pl-4" style="border-color: var(--border-bright);">
          "The AI Judge is incredible. It didn't just tell me my F1 score was too low; it analyzed my code and suggested I was overfitting due to lack of regularization. Best learning experience ever."
        </p>
        <div class="flex items-center gap-3 mt-auto">
          <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs"
               style="background: rgba(29,158,117,0.1); color: var(--green-dim); border: 1px solid rgba(29,158,117,0.3);">
            SJ
          </div>
          <div>
            <div class="text-[13px] font-bold text-[var(--text-primary)]">Sarah J.</div>
            <div class="font-mono text-[10px] text-[var(--text-muted)]">Data Scientist</div>
          </div>
        </div>
      </div>

      <!-- Testimonial 3 -->
      <div class="lift p-8 rounded-lg relative" style="background: var(--bg-surface-2); border: 1px solid var(--border);">
        <script type="application/ld+json">
        {
          "@context": "https://schema.org/",
          "@type": "Review",
          "itemReviewed": {
            "@type": "SoftwareApplication",
            "name": "CodeQuest AI"
          },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5"
          },
          "author": {
            "@type": "Person",
            "name": "David L."
          },
          "reviewBody": "I've been trying to learn LangChain and AI agents for months. CodeQuest AI's sandbox environment let me actually build them step-by-step without fighting environment setup errors."
        }
        </script>
        <div class="font-mono text-[10px] tracking-widest text-[var(--text-muted)] mb-4 uppercase">
          Rating: ★★★★★
        </div>
        <p class="text-sm leading-relaxed text-[var(--text-secondary)] italic mb-8 border-l-2 pl-4" style="border-color: var(--border-bright);">
          "I've been trying to learn LangChain and AI agents for months. CodeQuest AI's sandbox environment let me actually build them step-by-step without fighting environment setup errors."
        </p>
        <div class="flex items-center gap-3 mt-auto">
          <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs"
               style="background: rgba(250,199,117,0.1); color: var(--amber); border: 1px solid rgba(250,199,117,0.3);">
            DL
          </div>
          <div>
            <div class="text-[13px] font-bold text-[var(--text-primary)]">David L.</div>
            <div class="font-mono text-[10px] text-[var(--text-muted)]">Full Stack Dev</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

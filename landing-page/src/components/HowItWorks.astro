---
---
<section id="how-it-works" class="py-24 px-6 border-t border-[var(--border)] relative bg-[var(--bg-surface)]">
  <div class="max-w-6xl mx-auto">
    <div class="mb-20 text-center flex flex-col items-center">
      <div class="page-tag justify-center">
        // PROTOCOL_INITIALIZATION
      </div>
      <h2 class="page-heading text-3xl md:text-5xl">How CodeQuest AI Works</h2>
    </div>

    <div class="relative grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Dashed connecting line for desktop -->
      <div class="hidden md:block absolute top-10 left-[16.66%] right-[16.66%] h-px border-t border-dashed border-[var(--purple-border)] z-0"></div>

      <!-- Step 1 -->
      <div class="relative z-10 flex flex-col items-center text-center group">
        <div class="w-20 h-20 rounded-full flex items-center justify-center mb-6 transition-all duration-300"
             style="background: var(--bg-surface-2); border: 1px solid var(--border); box-shadow: 0 0 20px rgba(127,119,221,0.05);">
          <span class="font-display text-2xl" style="color: var(--purple-dim);">01</span>
        </div>
        <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Pick a Mission</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed max-w-xs">
          Get a GTA-style briefing from your NPC fixer. Understand the business problem and your objectives before touching any code.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="relative z-10 flex flex-col items-center text-center group">
        <div class="w-20 h-20 rounded-full flex items-center justify-center mb-6 transition-all duration-300"
             style="background: var(--bg-surface-2); border: 1px solid var(--border); box-shadow: 0 0 20px rgba(127,119,221,0.05);">
          <span class="font-display text-2xl" style="color: var(--purple-dim);">02</span>
        </div>
        <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">Code in Browser</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed max-w-xs">
          Write real Python code in our sandboxed environment. Use pandas, scikit-learn, LangChain, and real APIs right in your browser.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="relative z-10 flex flex-col items-center text-center group">
        <div class="w-20 h-20 rounded-full flex items-center justify-center mb-6 transition-all duration-300 circuit"
             style="background: rgba(127,119,221,0.05); border: 1px solid var(--purple); box-shadow: 0 0 32px rgba(127,119,221,0.15);">
          <span class="font-display text-2xl" style="color: var(--purple);">03</span>
        </div>
        <h3 class="text-xl font-bold text-[var(--text-primary)] mb-3">AI Scores You</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed max-w-xs">
          Submit your code and get instant, Claude-powered feedback. Learn from your mistakes, earn XP, and level up your developer profile.
        </p>
      </div>
    </div>
  </div>
</section>

---
---
<section class="py-24 bg-neon-cyan relative overflow-hidden">
  <!-- Glitch grid background overlay -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,black,transparent_80%)]"></div>
  <div class="absolute inset-0 opacity-20" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 19px, #000 19px, #000 20px), repeating-linear-gradient(90deg, transparent, transparent 19px, #000 19px, #000 20px); background-size: 20px 20px;"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h2 class="font-display font-black text-4xl md:text-6xl text-slate-950 mb-6 uppercase tracking-tight">
      Your First Mission Awaits, Agent.
    </h2>
    <p class="text-xl text-slate-800 font-medium mb-10 max-w-2xl mx-auto">
      Stop watching tutorials. Start building AI pipelines. Join 2,400+ developers mastering machine learning through gameplay.
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-6">
      <a href="http://localhost:3000" class="px-8 py-4 bg-slate-950 text-neon-cyan font-display font-bold text-lg hover:bg-slate-800 transition-colors shadow-2xl relative overflow-hidden group">
        <span class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
        <span class="relative">Start Free</span>
      </a>
      <a href="#curriculum" class="px-8 py-4 bg-transparent border-2 border-slate-950 text-slate-950 font-display font-bold text-lg hover:bg-slate-950 hover:text-neon-cyan transition-colors">
        View Curriculum
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-slate-950 py-12 border-t border-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center">
    <div class="flex items-center mb-6 md:mb-0">
      <span class="font-display font-black text-xl tracking-wider text-white">
        CODEQUEST<span class="text-neon-cyan">_</span>
      </span>
      <span class="ml-4 text-slate-500 text-sm">© 2025 CodeQuest AI</span>
    </div>

    <div class="flex flex-wrap justify-center gap-6">
      <a href="#features" class="text-slate-400 hover:text-neon-cyan text-sm transition-colors">Features</a>
      <a href="#pricing" class="text-slate-400 hover:text-neon-cyan text-sm transition-colors">Pricing</a>
      <a href="/blog" class="text-slate-400 hover:text-neon-cyan text-sm transition-colors">Blog</a>
      <a href="/privacy" class="text-slate-400 hover:text-neon-cyan text-sm transition-colors">Privacy</a>
      <a href="/terms" class="text-slate-400 hover:text-neon-cyan text-sm transition-colors">Terms</a>
    </div>
  </div>
</footer>

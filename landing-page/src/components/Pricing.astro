---
---
<section id="pricing" class="py-24 px-6 border-t border-[var(--border)] relative bg-[var(--bg-surface)]">
  <div class="max-w-4xl mx-auto">
    <div class="mb-16 text-center flex flex-col items-center">
      <div class="page-tag justify-center">
        // UPGRADE_PATH
      </div>
      <h2 class="page-heading text-3xl md:text-5xl max-w-2xl">Start Free. Go Pro When You're Ready.</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      <!-- Free Tier -->
      <div class="lift p-8 rounded-lg relative flex flex-col" style="background: var(--bg-surface-2); border: 1px solid var(--border);">
        <h3 class="text-xl font-display font-bold text-[var(--text-primary)] mb-2">Free License</h3>
        <div class="font-mono text-4xl font-bold text-[var(--text-primary)] mb-4">
          $0 <span class="text-[13px] font-sans text-[var(--text-muted)] font-normal">/ forever</span>
        </div>
        <p class="text-sm text-[var(--text-secondary)] mb-8 border-b border-[var(--border-bright)] pb-6">
          Perfect for beginners wanting to taste the dystopian future of AI.
        </p>
        <a href="http://localhost:3000" class="block w-full text-center py-2 px-4 rounded mb-8 font-bold" 
           style="background: rgba(127,119,221,0.08); color: var(--purple-dim); border: 1px solid rgba(127,119,221,0.25); font-size: 13px; letter-spacing: 0.06em;">
          START FREE
        </a>
      </div>

      <!-- Pro Tier -->
      <div class="lift p-8 rounded-lg relative flex flex-col circuit" 
           style="background: var(--bg-surface-2); border: 1px solid var(--purple); box-shadow: 0 0 32px rgba(127,119,221,0.1);">
        <div class="absolute top-0 right-0 px-3 py-1 bg-[var(--purple)] text-[var(--bg-base)] text-[10px] font-mono font-bold tracking-widest rounded-bl-lg">
          RECOMMENDED
        </div>
        <h3 class="text-xl font-display font-bold text-[var(--text-primary)] mb-2">Pro Agent</h3>
        <div class="font-mono text-4xl font-bold text-[var(--text-primary)] mb-4">
          $9 <span class="text-[13px] font-sans text-[var(--text-muted)] font-normal">/ month</span>
        </div>
        <p class="text-sm text-[var(--text-secondary)] mb-8 border-b border-[var(--border-bright)] pb-6">
          Full access to all chapters, missions, and advanced AI feedback.
        </p>
        <a href="http://localhost:3000/upgrade" class="block w-full text-center py-2 px-4 rounded mb-8 font-bold" 
           style="background: var(--purple); color: #EEEDFE; border: none; font-size: 13px; letter-spacing: 0.06em;">
          GO PRO
        </a>
      </div>
    </div>

    <!-- Feature Comparison Table -->
    <div class="overflow-x-auto">
      <h3 class="text-lg font-display font-bold text-[var(--text-primary)] mb-6 text-center uppercase tracking-wider">Feature Comparison</h3>
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr>
            <th class="p-4 border-b border-[var(--border-bright)] text-[var(--text-muted)] font-mono text-[11px] uppercase tracking-widest">Feature</th>
            <th class="p-4 border-b border-[var(--border-bright)] text-[var(--text-muted)] font-mono text-[11px] uppercase tracking-widest text-center">Free</th>
            <th class="p-4 border-b border-[var(--border-bright)] text-[var(--purple-dim)] font-mono text-[11px] uppercase tracking-widest text-center">Pro</th>
          </tr>
        </thead>
        <tbody class="text-[var(--text-secondary)]">
          <tr class="hover:bg-[var(--bg-surface-3)] transition-colors">
            <td class="p-4 border-b border-[var(--border)]">Missions Available</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono">Chapter 1</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--text-primary)]">All Chapters</td>
          </tr>
          <tr class="hover:bg-[var(--bg-surface-3)] transition-colors">
            <td class="p-4 border-b border-[var(--border)]">Browser Sandboxed Environment</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--green)]">✓</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--green)]">✓</td>
          </tr>
          <tr class="hover:bg-[var(--bg-surface-3)] transition-colors">
            <td class="p-4 border-b border-[var(--border)]">AI Code Judge</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono">Basic</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--text-primary)]">Deep Analysis</td>
          </tr>
          <tr class="hover:bg-[var(--bg-surface-3)] transition-colors">
            <td class="p-4 border-b border-[var(--border)]">RAG & AI Agent Challenges</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--text-muted)]">✗</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--green)]">✓</td>
          </tr>
          <tr class="hover:bg-[var(--bg-surface-3)] transition-colors">
            <td class="p-4 border-b border-[var(--border)]">Boss Challenges</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--text-muted)]">✗</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--green)]">✓</td>
          </tr>
          <tr class="hover:bg-[var(--bg-surface-3)] transition-colors">
            <td class="p-4 border-b border-[var(--border)]">Global Leaderboard Eligibility</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--text-muted)]">✗</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--green)]">✓</td>
          </tr>
          <tr class="hover:bg-[var(--bg-surface-3)] transition-colors">
            <td class="p-4 border-b border-[var(--border)]">NPC Fixer Interactions</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--text-muted)]">Limited</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--text-primary)]">Full Cast</td>
          </tr>
          <tr class="hover:bg-[var(--bg-surface-3)] transition-colors">
            <td class="p-4 border-b border-[var(--border)]">Priority Support</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--text-muted)]">✗</td>
            <td class="p-4 border-b border-[var(--border)] text-center font-mono text-[var(--green)]">✓</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

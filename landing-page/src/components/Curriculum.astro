---
const curriculum = [
  {
    chapter: "01",
    district: "District 01: The Awakening",
    title: "Python & Data Foundations",
    desc: "Learn Python, NumPy, Pandas, data analysis, and data cleaning through hacking missions. Master the fundamental tools used by every data scientist.",
    color: "#5DCAA5", // Teal / Ghost
  },
  {
    chapter: "02",
    district: "District 02: Control Flow City",
    title: "ML Fundamentals",
    desc: "Master scikit-learn, feature engineering, train/test splits, and ML models like regression and classification trees to predict corporate behavior.",
    color: "#FAC775", // Amber / Vex
  },
  {
    chapter: "03",
    district: "District 03: Data Structures",
    title: "RAG & Vector Search",
    desc: "Build real retrieval-augmented generation (RAG) pipelines using ChromaDB, vector embeddings, OpenAI, and LangChain to extract hidden intel.",
    color: "#7F77DD", // Purple / Nexus
  },
  {
    chapter: "04",
    district: "District 04: The Function Factory",
    title: "AI Agents",
    desc: "Create autonomous AI agents with tool use, memory, and multi-step reasoning using LangChain agents and the Claude API to infiltrate the system.",
    color: "#F0997B", // Coral / Cipher
  },
  {
    chapter: "05",
    district: "District 05: Neural Apex",
    title: "Deployment & MLOps",
    desc: "Fine-tuning, model deployment, FastAPI, and MLOps. Launch your models into production environments and defend them against adversarial attacks.",
    color: "#E24B4A", // Red / Architect
  }
];
---
<section id="curriculum" class="py-24 px-6 border-t border-[var(--border)] relative bg-[var(--bg-surface)]">
  <div class="max-w-4xl mx-auto">
    <div class="mb-16">
      <div class="page-tag">
        // NEURAL_TRAINING_PATH
      </div>
      <h2 class="page-heading text-3xl md:text-5xl">What You'll Learn</h2>
      <p class="text-sm mt-4 border-l-2 pl-3 max-w-2xl" style="border-color: var(--purple); color: var(--text-secondary); line-height: 1.6;">
        A structured learn machine learning curriculum from Python basics to production AI deployments. Master the tools used by elite AI engineers.
      </p>
    </div>

    <div class="space-y-4">
      {curriculum.map(ch => (
        <div class="lift p-6 rounded-lg relative overflow-hidden flex flex-col md:flex-row gap-6 items-start" 
             style="background: var(--bg-surface-2); border: 1px solid var(--border);">
          <div class="absolute top-0 left-0 bottom-0 w-1" style={`background: ${ch.color}; opacity: 0.8;`}></div>
          
          <div class="md:w-1/3 flex-shrink-0">
            <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded mb-2 inline-block"
                  style={`background: ${ch.color}18; color: ${ch.color}; border: 1px solid ${ch.color}40`}>
              CHAPTER {ch.chapter}
            </span>
            <div class="font-mono text-[11px] uppercase tracking-wider mt-2" style={{ color: "var(--text-muted)" }}>
              {ch.district}
            </div>
            <h3 class="text-xl font-bold mt-2 font-display" style="color: var(--text-primary);">{ch.title}</h3>
          </div>
          
          <div class="md:w-2/3">
            <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
              {ch.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

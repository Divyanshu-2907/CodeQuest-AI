---
---
<footer class="py-12 px-6" style="background: var(--bg-base); border-top: 1px solid var(--border);">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex flex-col items-center md:items-start gap-2">
      <a href="/" class="flex items-center gap-2 no-underline">
        <div class="w-6 h-6 rounded flex items-center justify-center text-[10px] font-black"
             style="background: rgba(127,119,221,0.2); color: #7F77DD; border: 1px solid rgba(127,119,221,0.4);">
          CQ
        </div>
        <span class="font-display text-sm font-black" style="color: #7F77DD; letter-spacing: -0.02em;">
          CODEQUEST_
        </span>
      </a>
      <span class="font-mono text-[10px] text-[var(--text-muted)] tracking-widest mt-2 uppercase">
        © 2025 CodeQuest AI. All systems online.
      </span>
    </div>

    <div class="flex gap-12 text-sm font-mono text-[11px] tracking-widest uppercase">
      <div class="flex flex-col gap-3">
        <span class="text-[var(--text-primary)] font-bold mb-1">Product</span>
        <a href="#features" class="text-[var(--text-muted)] hover:text-[var(--purple-dim)] transition-colors">Features</a>
        <a href="#curriculum" class="text-[var(--text-muted)] hover:text-[var(--purple-dim)] transition-colors">Curriculum</a>
        <a href="#pricing" class="text-[var(--text-muted)] hover:text-[var(--purple-dim)] transition-colors">Pricing</a>
      </div>
      
      <div class="flex flex-col gap-3">
        <span class="text-[var(--text-primary)] font-bold mb-1">Resources</span>
        <a href="/blog" class="text-[var(--text-muted)] hover:text-[var(--purple-dim)] transition-colors">Blog</a>
        <a href="http://localhost:3000/docs" class="text-[var(--text-muted)] hover:text-[var(--purple-dim)] transition-colors">Documentation</a>
      </div>
      
      <div class="flex flex-col gap-3">
        <span class="text-[var(--text-primary)] font-bold mb-1">Legal</span>
        <a href="/privacy" class="text-[var(--text-muted)] hover:text-[var(--purple-dim)] transition-colors">Privacy</a>
        <a href="/terms" class="text-[var(--text-muted)] hover:text-[var(--purple-dim)] transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>

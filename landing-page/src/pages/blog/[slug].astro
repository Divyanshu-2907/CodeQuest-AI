---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — CodeQuest AI`}
  description={post.data.description}
  ogImage={post.data.image}
>
  <Nav />
  
  <main class="pt-32 pb-24 px-6 relative bg-[var(--bg-base)] min-h-screen">
    <article class="max-w-3xl mx-auto">
      <header class="mb-12 border-b border-[var(--border)] pb-10">
        <div class="flex items-center gap-2 mb-6">
          <div class="page-tag !mb-0">
            // SECURE_LOG_ENTRY
          </div>
          <span class="text-[var(--text-muted)]">/</span>
          <span class="font-mono text-[10px] uppercase tracking-widest text-[var(--purple-dim)]">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </span>
        </div>
        
        <h1 class="page-heading text-3xl md:text-5xl mb-6 leading-tight max-w-2xl">
          {post.data.title}
        </h1>
        
        <p class="text-lg text-[var(--text-secondary)] mb-8 max-w-2xl leading-relaxed">
          {post.data.description}
        </p>
        
        <div class="flex items-center gap-2">
          {post.data.tags.map(tag => (
            <span class="tag-side font-mono text-[10px] font-bold px-2 py-0.5 rounded uppercase">
              {tag}
            </span>
          ))}
        </div>
      </header>
      
      <div class="prose prose-invert prose-slate max-w-none 
                  prose-headings:font-display prose-headings:text-[var(--text-primary)] 
                  prose-a:text-[var(--purple)] hover:prose-a:text-[var(--purple-bright)] 
                  prose-code:text-[var(--green-dim)] prose-code:font-mono 
                  prose-pre:bg-[var(--bg-surface-3)] prose-pre:border prose-pre:border-[var(--border)]
                  prose-p:text-[var(--text-secondary)] prose-p:leading-relaxed">
        <Content />
      </div>
    </article>
  </main>
  
  <FinalCTA />
  <Footer />
</BaseLayout>
